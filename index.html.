<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Tələbə Xidmətləri</title>
<style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:"Times New Roman", Times, serif;
  background:#eef7ff;
  color:#0b356d
}
.top{
  background:linear-gradient(135deg,#0b4f8f,#168bd0);
  color:#fff;
  padding:22px 16px;
  text-align:center
}
.top .uni{
  font-size:13px;
  letter-spacing:.5px;
  opacity:.95
}
.top h1{
  margin:8px 0 0;
  font-size:30px
}
.wrap{
  max-width:700px;
  margin:auto;
  padding:18px 14px 28px
}
.intro{
  text-align:center;
  margin:0 0 18px;
  color:#42627f
}
.card{
  display:flex;
  align-items:center;
  gap:14px;
  margin:12px 0;
  padding:18px 18px;
  border-radius:20px;
  text-decoration:none;
  color:#0b356d;
  font-weight:700;
  font-size:20px;
  box-shadow:0 4px 12px rgba(52,100,140,.12)
}
.card .ico{
  font-size:30px;
  width:42px;
  text-align:center
}
.card .txt{flex:1}
.card .sub{
  display:block;
  font-size:13px;
  font-weight:400;
  margin-top:4px;
  color:#4c6680
}
.card .arr{
  font-size:28px
}
.a{background:#cfeeff}
.b{background:#d4f7ef}
.c{background:#fff0c9}
.d{background:#ffdfe5}
.e{background:#e5ddff}
.f{background:#d7f4f7}
.g{background:#ffddea}
.off{
  opacity:.6;
  pointer-events:none
}
footer{
  text-align:center;
  padding:14px 8px 8px;
  font-style:italic;
  font-weight:700;
  color:#0b4f93
}
</style>
</head>
<body>
<div class="top">
  <div class="uni">BAKI BİZNES UNİVERSİTETİ · BİZNES VƏ MENECMENT FAKÜLTƏSİ</div>
